# Frontend-specific rules live in frontend/.gitignore

# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Local databases
*.sqlite3
*.db

# Infrastructure
.aws-sam/
cdk.out/
.terraform/
*.tfstate
*.tfstate.*

# Logs
*.log

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini
